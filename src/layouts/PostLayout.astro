---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';
import { formatDateLong, readingTime } from '@/lib/format';
import ReadingProgress from '@/components/ReadingProgress.astro';
import FloatingShare from '@/components/FloatingShare.astro';
import HighlightShare from '@/components/HighlightShare.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ClapButton from '@/components/ClapButton.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import AuthorBio from '@/components/AuthorBio.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import SeriesNav from '@/components/SeriesNav.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import BackToTop from '@/components/BackToTop.astro';
import MobileTOC from '@/components/MobileTOC.astro';
import { getPublishedPosts, getSeriesPosts, getRelatedPosts } from '@/lib/post-cache';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, draft, tags, series, dropCap } = post.data;
const minutes = readingTime(post.body ?? '', SITE.wordsPerMinute);
const url = new URL(`/${post.id}/`, Astro.site ?? SITE.url).toString();

// Related posts: shared tags + same-series boost.
// Memoized via post-cache; ignores overly-generic tags (appearing on >5 posts).
const relatedPosts = await getRelatedPosts(post);

// Series posts — memoized per series name
const seriesPosts = series ? await getSeriesPosts(series.name) : [];

// Compute tag frequencies ONCE so the byline can render tags as links
// when they have 2+ posts (and thus a generated /tags/<tag>/ page) or
// as plain text when they're single-post (no dedicated page exists).
const allPublishedForTags = await getPublishedPosts();
const tagFreq = new Map<string, number>();
for (const p of allPublishedForTags) {
  for (const t of p.data.tags) {
    tagFreq.set(t, (tagFreq.get(t) ?? 0) + 1);
  }
}
function tagHasPage(tag: string): boolean {
  return (tagFreq.get(tag) ?? 0) >= 2;
}

// JSON-LD Article schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  ...(post.data.coverImage ? { image: post.data.coverImage } : {}),
  keywords: tags.join(', '),
  ...(series ? { isPartOf: { '@type': 'BlogSeries', name: series.name, position: series.part } } : {}),
};
---
<BaseLayout
  title={title}
  description={description}
  ogImage={post.data.coverImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  jsonLd={articleSchema}
>
  {/* Fixed-position chrome (no layout impact) */}
  <ReadingProgress />
  <FloatingShare url={url} title={title} />
  <HighlightShare />
  <BackToTop />

  <article class="fade-up">
    {/* ─────────────────────────────────────────────
        1. Article header
        Kicker → H1 → subtitle → series banner → byline
        ───────────────────────────────────────────── */}
    <header class="mb-10">
      <div class="flex items-center gap-3 text-xs font-sans uppercase tracking-wider text-[var(--fg-faint)] mb-4">
        <time datetime={pubDate.toISOString()}>{formatDateLong(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {draft && (
          <span class="text-[var(--accent)] font-medium">Draft</span>
        )}
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span class="italic normal-case tracking-normal">Updated {formatDateLong(updatedDate)}</span>
          </>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-[2.5rem] leading-[1.15] font-semibold tracking-tight text-[var(--fg)] mb-4">
        {title}
      </h1>

      {description && (
        <p class="font-serif text-lg sm:text-xl italic leading-relaxed text-[var(--fg-soft)]">
          {description}
        </p>
      )}

      {/* Series banner — sits above the byline so readers know
          they're in a multi-part series before they start reading. */}
      {series && seriesPosts.length > 0 && (
        <SeriesNav
          variant="banner"
          seriesName={series.name}
          currentPart={series.part}
          posts={seriesPosts}
        />
      )}

      {/* Byline: author + tags on one row.
          Tags with 2+ posts link to /tags/<tag>/; single-post tags
          render as plain text (no dedicated page exists for them). */}
      <div class="mt-5 flex items-center gap-3 flex-wrap">
        <AuthorBio variant="inline" />
        {tags.length > 0 && (
          <>
            <span class="text-[var(--fg-faint)]" aria-hidden="true">·</span>
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  {tagHasPage(tag) ? (
                    <a
                      href={`/tags/${tag}/`}
                      class="text-xs font-sans uppercase tracking-wider text-[var(--fg-faint)] hover:text-[var(--accent)] transition-colors"
                    >
                      #{tag}
                    </a>
                  ) : (
                    <span class="text-xs font-sans uppercase tracking-wider text-[var(--fg-faint)]">
                      #{tag}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </header>

    {/* ─────────────────────────────────────────────
        2. Mobile TOC (collapsible, above the body on small screens)
        ───────────────────────────────────────────── */}
    <MobileTOC headings={headings} />

    {/* ─────────────────────────────────────────────
        3. Article body + sticky TOC sidebar (desktop xl+)
        ───────────────────────────────────────────── */}
    <div class:list={['grid grid-cols-1 xl:grid-cols-[1fr_180px] gap-8 xl:gap-12']}>
      <div class:list={['prose min-w-0', dropCap && 'drop-cap']}>
        <slot />
      </div>
      <div class="order-first xl:order-last">
        <TableOfContents headings={headings} />
      </div>
    </div>

    {/* ─────────────────────────────────────────────
        4. Engagement bar — clap + share grouped together
        Sits right after the article body, before the bio.
        ───────────────────────────────────────────── */}
    <section
      class="mt-12 pt-8 border-t border-[var(--line)] flex flex-wrap items-center justify-between gap-4"
      aria-label="Engagement"
    >
      <ClapButton slug={post.id} />
      <ShareButtons url={url} title={title} />
    </section>

    {/* ─────────────────────────────────────────────
        5. Author bio card
        ───────────────────────────────────────────── */}
    <AuthorBio variant="card" />

    {/* ─────────────────────────────────────────────
        6. Discovery — "what to read next"
        Series nav (if part of a series) comes first as the primary
        continuation, then related posts as secondary suggestions.
        ───────────────────────────────────────────── */}
    {series && seriesPosts.length > 0 && (
      <SeriesNav
        variant="nav"
        seriesName={series.name}
        currentPart={series.part}
        posts={seriesPosts}
      />
    )}

    <RelatedPosts posts={relatedPosts} title="Read next" />

    {/* ─────────────────────────────────────────────
        7. Subscribe CTA — last thing in the article
        ───────────────────────────────────────────── */}
    <section id="subscribe" class="mt-12 p-6 rounded-lg border border-[var(--line)] bg-[color-mix(in_srgb,var(--accent)_4%,var(--bg))]">
      <p class="text-xs font-sans uppercase tracking-wider text-[var(--accent)] mb-2">
        Subscribe
      </p>
      <h3 class="font-serif text-xl font-semibold mb-2">
        Get new essays in your inbox.
      </h3>
      <p class="font-serif text-[1.0625rem] text-[var(--fg-soft)] mb-4 leading-relaxed">
        Slow, considered writing — about once a month. No spam, unsubscribe anytime.
      </p>
      <SubscribeForm />
    </section>
  </article>
</BaseLayout>
