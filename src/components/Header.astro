---
import { SITE } from '@/lib/site';
import ThemeToggle from '@/components/ThemeToggle.astro';

const pathname = Astro.url.pathname;
const subscribeUrl = SITE.newsletter.subscribeUrl;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/series', label: 'Series' },
  { href: '/archive', label: 'Archive' },
  { href: '/search', label: 'Search' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---
<header class="border-b border-[var(--line)] sticky top-0 z-40 bg-[var(--bg)]/85 backdrop-blur-md">
  <div class="mx-auto w-full max-w-2xl px-5 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a
      href="/"
      class="font-serif text-lg font-semibold tracking-tight text-[var(--fg)] hover:text-[var(--accent)] transition-colors"
    >
      {SITE.title}
    </a>

    <nav class="flex items-center gap-5 sm:gap-6">
      {/* Desktop nav links — hidden on mobile */}
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm transition-colors hidden sm:inline',
            isActive(item.href)
              ? 'text-[var(--fg)] font-medium'
              : 'text-[var(--fg-faint)] hover:text-[var(--fg)]',
          ]}
        >
          {item.label}
        </a>
      ))}

      {/* Subscribe pill — hidden on mobile (moved into the dropdown).
          Uses shared .pill class so it matches the 404 tag pills exactly.
          Opens Paragraph's hosted subscribe modal in a new tab. */}
      <a
        href={subscribeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-block pill"
      >
        Subscribe
      </a>

      {/* Theme toggle — visible on both mobile and desktop (small, always accessible) */}
      <ThemeToggle />

      {/* Mobile hamburger — far-right corner on mobile only.
          Touch target ≥44×44 per WCAG 2.5.5 (was p-1, now p-2.5 → 40px+ icon). */}
      <button
        type="button"
        id="mobile-menu-toggle"
        class="sm:hidden p-2.5 -mr-2 text-[var(--fg-faint)] hover:text-[var(--fg)] transition-colors rounded-md hover:bg-[color-mix(in_srgb,var(--fg)_5%,transparent)]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="menu-open-icon"
          aria-hidden="true"
        >
          <path d="M3 12h18M3 6h18M3 18h18" />
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="menu-close-icon hidden"
          aria-hidden="true"
        >
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  {/* Mobile menu dropdown — nav links + Subscribe.
      Theme toggle stays in the header bar (visible on mobile too).
      Animates open/closed via max-height transition (no layout jank). */}
  <div
    id="mobile-menu"
    class="sm:hidden mobile-menu-dropdown border-t border-[var(--line)] bg-[var(--bg)] overflow-hidden"
  >
    <nav class="mx-auto w-full max-w-2xl px-5 sm:px-6 py-3 flex flex-col">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'py-2.5 text-sm transition-colors border-b border-[var(--line)] last:border-b-0',
            isActive(item.href)
              ? 'text-[var(--fg)] font-medium'
              : 'text-[var(--fg-soft)] hover:text-[var(--accent)]',
          ]}
        >
          {item.label}
        </a>
      ))}

      <a
        href={subscribeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="pill mt-4 self-start"
      >
        Subscribe
      </a>
    </nav>
  </div>
</header>

<style>
  /* Mobile menu: collapsed by default, slides open when [data-open].
     max-height transition is smooth and avoids layout shift on close. */
  .mobile-menu-dropdown {
    max-height: 0;
    transition: max-height var(--transition-base), padding-top var(--transition-base), padding-bottom var(--transition-base);
    padding-top: 0;
    padding-bottom: 0;
  }
  .mobile-menu-dropdown[data-open] {
    max-height: 600px;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-dropdown { transition: none; }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle?.querySelector('.menu-open-icon');
  const closeIcon = toggle?.querySelector('.menu-close-icon');
  let lastFocusedElement: HTMLElement | null = null;

  function setMenuOpen(open: boolean) {
    if (!menu || !toggle || !openIcon || !closeIcon) return;
    // The menu uses [data-open] + max-height transition for show/hide.
    // (Previously also called classList.toggle('hidden') — but the menu
    // no longer has a 'hidden' class, so that call was a no-op.)
    menu.toggleAttribute('data-open', open);
    openIcon.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    if (open) {
      // Move focus into the menu
      lastFocusedElement = document.activeElement as HTMLElement;
      const firstLink = menu.querySelector('a') as HTMLElement | null;
      setTimeout(() => firstLink?.focus(), 50);
    } else {
      // Restore focus to the hamburger button
      lastFocusedElement?.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.hasAttribute('data-open');
    setMenuOpen(!isOpen);
  });

  // Close menu when a link is clicked
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMenuOpen(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (menu?.hasAttribute('data-open')) {
      const target = e.target as Node;
      if (menu && !menu.contains(target) && toggle && !toggle.contains(target)) {
        setMenuOpen(false);
      }
    }
  });
</script>
