---
import SubscribeForm from '@/components/SubscribeForm.astro';
---
<aside class="mid-article-cta">
  <p class="text-xs font-sans uppercase tracking-wider text-[var(--accent)] mb-2">
    Enjoying this? Get the next essay in your inbox.
  </p>
  <p class="font-serif text-[1rem] text-[var(--fg-soft)] mb-4 leading-relaxed">
    No spam, no algorithms. One essay every few weeks — the same kind of thing
    you're reading now.
  </p>
  <SubscribeForm variant="compact" />
  <p class="text-xs font-sans text-[var(--fg-faint)] mt-3 text-center">
    Or <a href="#subscribe" class="underline underline-offset-2 hover:text-[var(--accent)]">scroll down</a> for the full sign-up.
  </p>
</aside>
