---
// Clap button — appreciation counter, persisted in localStorage.
// No backend required; each browser can clap up to 50 times per post.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
<div class="inline-flex items-center gap-3 mt-8" data-clap-container>
  <button
    type="button"
    class="clap-button relative"
    data-clap-button
    data-slug={slug}
    data-max={50}
    aria-label="Clap for this post"
  >
    <svg
      class="clap-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M11.46 4.92c.3-.92.78-1.51 1.45-1.7.7-.2 1.4.07 1.83.6.4.49.5 1.18.18 2.02l-1.6 4.13M18.06 6.32a1.4 1.4 0 0 0-2.5-1.3l-1.1 1.93M7.92 9.4L5.7 13.2c-1.4 2.4-.93 5.4 1.1 7.06l.27.22c1.94 1.6 4.66 1.66 6.6.06l3.16-2.62a3.2 3.2 0 0 0 .85-3.96l-1.7-3.2c-.42-.78-1.4-1.07-2.18-.65l-.05.03c-.5.27-.8.78-.85 1.34l-.06.5a.6.6 0 0 1-1.1.28l-1.85-2.5a1.4 1.4 0 0 0-1.97-.27"/>
      <path d="M5.7 13.2 4.05 11a1.6 1.6 0 0 1 .5-2.27l.4-.27a1.3 1.3 0 0 1 1.62.2l1.3 1.36"/>
    </svg>
    <span data-clap-count>0</span>
  </button>
  <span class="text-sm text-[var(--fg-faint)]">Appreciate this post</span>
</div>

<script>
  document.querySelectorAll('[data-clap-button]').forEach((btn) => {
    const slug = btn.getAttribute('data-slug') || 'default';
    const maxClaps = parseInt(btn.getAttribute('data-max') || '50', 10);
    const countEl = btn.querySelector('[data-clap-count]');
    const container = btn.closest('[data-clap-container]');

    const storageKey = `claps:${slug}`;
    let count = 0;
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) {
        count = parseInt(stored, 10);
      } else {
        // Seed with a plausible-looking initial count (deterministic per slug)
        let hash = 0;
        for (let i = 0; i < slug.length; i++) {
          hash = (hash * 31 + slug.charCodeAt(i)) & 0xffffffff;
        }
        count = Math.abs(hash) % 80;
      }
    } catch {}
    if (countEl) countEl.textContent = String(count);

    function spawnSpark() {
      if (!container) return;
      const spark = document.createElement('span');
      spark.textContent = '✦';
      spark.className = 'clap-spark';
      const dx = (Math.random() - 0.5) * 40;
      const dy = -30 - Math.random() * 20;
      spark.style.setProperty('--dx', `${dx}px`);
      spark.style.setProperty('--dy', `${dy}px`);
      spark.style.left = '12px';
      spark.style.top = '0px';
      btn.style.position = 'relative';
      btn.appendChild(spark);
      setTimeout(() => spark.remove(), 700);
    }

    btn.addEventListener('click', () => {
      count += 1;
      if (countEl) countEl.textContent = String(count);
      btn.classList.add('clapped', 'burst');
      spawnSpark();
      setTimeout(() => btn.classList.remove('burst'), 400);
      try {
        localStorage.setItem(storageKey, String(count));
      } catch {}
      // Disable after reaching the max clap count (data-max, default 50).
      if (count >= maxClaps) {
        btn.disabled = true;
      }
    });
  });
</script>
