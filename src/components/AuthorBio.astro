---
import { SITE } from '@/lib/site';

// Compute initials from author name
function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s[0]?.toUpperCase() ?? '')
    .join('');
}

interface Props {
  variant?: 'inline' | 'card';
}

const { variant = 'card' } = Astro.props;
const init = initials(SITE.author);
const subscribeUrl = SITE.newsletter.subscribeUrl;
---
{variant === 'inline' ? (
  <span class="inline-flex items-center gap-2">
    <span class="avatar avatar-sm">{init}</span>
    <span class="text-sm font-medium text-[var(--fg)]">{SITE.author}</span>
  </span>
) : (
  <section class="flex flex-col sm:flex-row gap-5 items-start mt-12 pt-8 border-t border-[var(--line)]">
    <span class="avatar avatar-lg">{init}</span>
    <div class="flex-1">
      <p class="text-xs font-sans uppercase tracking-wider text-[var(--fg-faint)] mb-1">Written by</p>
      <h3 class="font-serif text-xl font-semibold mb-2 text-[var(--fg)]">{SITE.author}</h3>
      <p class="font-serif text-[1.0625rem] leading-relaxed text-[var(--fg-soft)] mb-3">
        {SITE.bio}
      </p>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <a
          href={subscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--accent)] hover:text-[var(--accent-soft)] transition-colors font-medium"
        >Subscribe</a>
        {SITE.social.twitter && (
          <a href={SITE.social.twitter} target="_blank" rel="noopener noreferrer" class="text-[var(--fg-faint)] hover:text-[var(--accent)] transition-colors">Twitter</a>
        )}
        {SITE.social.github && (
          <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="text-[var(--fg-faint)] hover:text-[var(--accent)] transition-colors">GitHub</a>
        )}
        {SITE.social.linkedin && (
          <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--fg-faint)] hover:text-[var(--accent)] transition-colors">LinkedIn</a>
        )}
        <a href={`mailto:${SITE.email}`} class="text-[var(--fg-faint)] hover:text-[var(--accent)] transition-colors">Email</a>
        <a href={SITE.social.rss} class="text-[var(--fg-faint)] hover:text-[var(--accent)] transition-colors">RSS</a>
      </div>
    </div>
  </section>
)}
