---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/series', label: 'Series' },
  { href: '/archive', label: 'Archive' },
  { href: '/search', label: 'Search' },
];
---
<footer class="border-t border-[var(--line)] mt-24">
  <div class="mx-auto w-full max-w-2xl px-5 sm:px-6 py-10">
    {/* Top row: site name + tagline */}
    <div class="mb-6">
      <a
        href="/"
        class="font-serif text-base font-semibold tracking-tight text-[var(--fg)] hover:text-[var(--accent)] transition-colors"
      >
        {SITE.title}
      </a>
      <p class="font-serif text-sm text-[var(--fg-soft)] mt-1 max-w-md leading-relaxed">
        {SITE.tagline}
      </p>
    </div>

    {/* Middle row: nav links (left) + social links (right) */}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-sm">
      <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[var(--fg-faint)]">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="hover:text-[var(--fg)] transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <nav aria-label="Social" class="flex items-center gap-4 text-[var(--fg-faint)]">
        {SITE.social.twitter && (
          <a
            href={SITE.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-[var(--fg)] transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>Twitter</span>
          </a>
        )}
        {SITE.social.github && (
          <a
            href={SITE.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-[var(--fg)] transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
            <span>GitHub</span>
          </a>
        )}
        <a
          href={SITE.social.rss}
          class="inline-flex items-center gap-1.5 hover:text-[var(--fg)] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.127-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"/>
          </svg>
          <span>RSS</span>
        </a>
      </nav>
    </div>

    {/* Bottom row: copyright + colophon */}
    <div class="mt-6 pt-6 border-t border-[var(--line)] text-xs text-[var(--fg-faint)]">
      <p>
        &copy; {year} {SITE.author}. Built with{' '}
        <a
          href="https://astro.build"
          class="text-[var(--fg-soft)] hover:text-[var(--accent)] underline underline-offset-2"
          target="_blank"
          rel="noopener noreferrer"
        >Astro</a>. Source on{' '}
        <a
          href={SITE.social.github}
          class="text-[var(--fg-soft)] hover:text-[var(--accent)] underline underline-offset-2"
          target="_blank"
          rel="noopener noreferrer"
        >GitHub</a>.
      </p>
    </div>
  </div>
</footer>
