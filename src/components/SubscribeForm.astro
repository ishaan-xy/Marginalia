---
import { SITE } from '@/lib/site';

interface Props {
  variant?: 'compact' | 'full';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
const url = SITE.newsletter.embedUrl;
---
<div
  class:list={['subscribe-embed', variant, className]}
  data-paragraph-embed
>
  <iframe
    src={url}
    title="Subscribe to the newsletter"
    loading="lazy"
    class="subscribe-iframe"
    frameborder="0"
    scrolling="no"
  ></iframe>
</div>

<style>
  .subscribe-embed {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  .subscribe-embed.full {
    max-width: 480px;
  }
  .subscribe-embed.compact {
    /* The Paragraph iframe is designed at 480×360; for the compact variant
       we keep the same width but allow the iframe to scale down on small
       screens via the responsive CSS below. */
    max-width: 100%;
  }
  .subscribe-iframe {
    display: block;
    width: 100%;
    height: 360px;
    max-width: 480px;
    margin: 0 auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    /* Paragraph's iframe is rendered with its own light theme; in dark mode we
       keep the page background behind it so the iframe doesn't look like a
       white island. Use a neutral backdrop that matches the page. */
    background: var(--bg);
    color-scheme: light;
  }
  /* On very small screens, allow the iframe to shrink but keep aspect ratio */
  @media (max-width: 520px) {
    .subscribe-iframe {
      height: 380px; /* a touch taller to fit mobile form fields comfortably */
    }
  }
</style>
