---
import { SITE } from '@/lib/site';

interface Props {
  variant?: 'compact' | 'full';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
const subscribeUrl = SITE.newsletter.subscribeUrl;
---
<div class:list={['subscribe-cta-card', variant, className]}>
  <a
    href={subscribeUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="subscribe-cta-link"
    aria-label="Subscribe to the Marginalia newsletter — opens in a new tab"
  >
    <span class="subscribe-cta-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    </span>
    <span class="subscribe-cta-text">
      <span class="subscribe-cta-headline">Subscribe to Marginalia</span>
      <span class="subscribe-cta-sub">Get new essays in your inbox. About once a month, never on a schedule.</span>
    </span>
    <span class="subscribe-cta-arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </a>
  <p class="subscribe-cta-footnote">
    Hosted by Paragraph. No spam, unsubscribe anytime.
  </p>
</div>

<style>
  /* Subscribe CTA card — replaces the broken iframe form.
     A single, prominent link styled as a card that opens Paragraph's
     hosted subscribe modal in a new tab. */
  .subscribe-cta-card {
    display: block;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  .subscribe-cta-card.compact {
    max-width: 100%;
  }

  .subscribe-cta-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--accent) 4%, var(--bg));
    text-decoration: none;
    color: var(--fg);
    transition: all var(--transition-base);
  }
  .subscribe-cta-link:hover,
  .subscribe-cta-link:focus-visible {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
    transform: translateY(-1px);
    outline: none;
  }
  .subscribe-cta-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Envelope icon on the left */
  .subscribe-cta-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
  }

  /* Text block — headline + sub-text */
  .subscribe-cta-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .subscribe-cta-headline {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
  }
  .subscribe-cta-sub {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--fg-soft);
    line-height: 1.4;
  }

  /* Arrow on the right — shifts right on hover for affordance */
  .subscribe-cta-arrow {
    flex-shrink: 0;
    color: var(--fg-faint);
    transition: transform var(--transition-base), color var(--transition-base);
  }
  .subscribe-cta-link:hover .subscribe-cta-arrow,
  .subscribe-cta-link:focus-visible .subscribe-cta-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  /* Footnote below the card */
  .subscribe-cta-footnote {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--fg-faint);
    margin: 0.75rem 0 0;
    line-height: 1.4;
  }

  /* On mobile, shrink the icon and tighten the spacing */
  @media (max-width: 520px) {
    .subscribe-cta-link {
      padding: 1rem 1.1rem;
      gap: 0.75rem;
    }
    .subscribe-cta-icon {
      width: 36px;
      height: 36px;
    }
    .subscribe-cta-headline {
      font-size: 1rem;
    }
    .subscribe-cta-sub {
      font-size: 0.75rem;
    }
  }

  /* Respect reduced motion — no transform on hover */
  @media (prefers-reduced-motion: reduce) {
    .subscribe-cta-link,
    .subscribe-cta-arrow {
      transition: none;
    }
    .subscribe-cta-link:hover,
    .subscribe-cta-link:focus-visible {
      transform: none;
    }
    .subscribe-cta-link:hover .subscribe-cta-arrow,
    .subscribe-cta-link:focus-visible .subscribe-cta-arrow {
      transform: none;
    }
  }
</style>
