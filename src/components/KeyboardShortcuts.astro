---
// Global keyboard shortcuts:
//   /         focus the search bar (or navigate to /search)
//   t         toggle theme
//   g h       go home
//   g a       go to archive
//   g s       go to search
//   g b       go back to top
//   ?         show the help overlay
//   Esc       close the help overlay
---
<div id="shortcuts-overlay" class="shortcuts-overlay" aria-hidden="true">
  <div class="shortcuts-card" role="dialog" aria-label="Keyboard shortcuts">
    <div class="shortcuts-header">
      <h2>Keyboard shortcuts</h2>
      <button type="button" data-close-overlay aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <dl class="shortcuts-list">
      <div><dt><kbd>/</kbd></dt><dd>Search</dd></div>
      <div><dt><kbd>t</kbd></dt><dd>Toggle theme</dd></div>
      <div><dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>Go home</dd></div>
      <div><dt><kbd>g</kbd> <kbd>a</kbd></dt><dd>Archive</dd></div>
      <div><dt><kbd>g</kbd> <kbd>s</kbd></dt><dd>Search page</dd></div>
      <div><dt><kbd>g</kbd> <kbd>t</kbd></dt><dd>Back to top</dd></div>
      <div><dt><kbd>?</kbd></dt><dd>Show this help</dd></div>
      <div><dt><kbd>Esc</kbd></dt><dd>Close overlay</dd></div>
    </dl>
  </div>
</div>

<style>
  .shortcuts-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--fg) 35%, transparent);
    backdrop-filter: blur(4px);
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .shortcuts-overlay.visible {
    display: flex;
    animation: fadeIn 0.15s ease-out;
  }
  .shortcuts-card {
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
  }
  .shortcuts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .shortcuts-header h2 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }
  .shortcuts-header button {
    background: transparent;
    border: none;
    color: var(--fg-faint);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: color 0.15s ease;
  }
  .shortcuts-header button:hover { color: var(--fg); }
  .shortcuts-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .shortcuts-list > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
  }
  .shortcuts-list dt {
    display: flex;
    gap: 0.25rem;
    margin: 0;
  }
  .shortcuts-list dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--fg-soft);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 6px;
    color: var(--fg);
    min-width: 1.5rem;
    text-align: center;
    display: inline-block;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shortcuts-overlay.visible { animation: none; }
  }
</style>

<script>
  const overlay = document.getElementById('shortcuts-overlay');
  const closeBtn = overlay?.querySelector('[data-close-overlay]');

  function showOverlay() {
    overlay?.classList.add('visible');
    overlay?.setAttribute('aria-hidden', 'false');
    closeBtn?.focus();
  }
  function hideOverlay() {
    overlay?.classList.remove('visible');
    overlay?.setAttribute('aria-hidden', 'true');
  }

  closeBtn?.addEventListener('click', hideOverlay);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) hideOverlay();
  });

  // Single-key vs. two-key (g + x) sequence
  let prefix: 'g' | null = null;
  let prefixTimeout: number | undefined;

  function clearPrefix() {
    prefix = null;
    window.clearTimeout(prefixTimeout);
  }

  function isTyping(): boolean {
    const el = document.activeElement as HTMLElement | null;
    if (!el) return false;
    const tag = el.tagName.toLowerCase();
    return tag === 'input' || tag === 'textarea' || el.isContentEditable;
  }

  document.addEventListener('keydown', (e) => {
    // Esc always works (close overlay)
    if (e.key === 'Escape') {
      if (overlay?.classList.contains('visible')) {
        hideOverlay();
        e.preventDefault();
        return;
      }
      // Otherwise let the original handler (e.g. search ESC) run
    }

    // Don't intercept shortcuts when typing
    if (isTyping()) return;

    // Modifier-key combos are passed through (let user keep Cmd+K etc.)
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    // Two-key sequences: g then h/a/s/t
    if (prefix === 'g') {
      clearPrefix();
      switch (e.key) {
        case 'h': window.location.href = '/'; e.preventDefault(); return;
        case 'a': window.location.href = '/archive'; e.preventDefault(); return;
        case 's': window.location.href = '/search'; e.preventDefault(); return;
        case 't': {
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
          e.preventDefault();
          return;
        }
        default:
          // Unknown second key — ignore
          return;
      }
    }

    // Single-key shortcuts
    switch (e.key) {
      case '/':
        e.preventDefault();
        // If we're on the search page, just focus the input
        const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        } else {
          window.location.href = '/search';
        }
        return;
      case 't':
        e.preventDefault();
        document.getElementById('theme-toggle')?.click();
        return;
      case 'g':
        prefix = 'g';
        prefixTimeout = window.setTimeout(clearPrefix, 800);
        return;
      case '?':
        e.preventDefault();
        showOverlay();
        return;
    }
  });
</script>
