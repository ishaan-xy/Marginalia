---
// Global keyboard shortcuts:
//   /         focus the search bar (or navigate to /search)
//   t         toggle theme
//   g h       go home
//   g a       go to archive
//   g s       go to search
//   g t       go back to top
//   ?         show the help overlay
//   Esc       close the help overlay
---
<div id="shortcuts-overlay" class="shortcuts-overlay" aria-hidden="true">
  <div class="shortcuts-card" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts">
    <div class="shortcuts-header">
      <h2>Keyboard shortcuts</h2>
      <button type="button" data-close-overlay aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <dl class="shortcuts-list">
      <div><dt><kbd aria-hidden="true">/</kbd></dt><dd>Search</dd></div>
      <div><dt><kbd aria-hidden="true">t</kbd></dt><dd>Toggle theme</dd></div>
      <div><dt><kbd aria-hidden="true">g</kbd> <kbd aria-hidden="true">h</kbd></dt><dd>Go home</dd></div>
      <div><dt><kbd aria-hidden="true">g</kbd> <kbd aria-hidden="true">a</kbd></dt><dd>Archive</dd></div>
      <div><dt><kbd aria-hidden="true">g</kbd> <kbd aria-hidden="true">s</kbd></dt><dd>Search page</dd></div>
      <div><dt><kbd aria-hidden="true">g</kbd> <kbd aria-hidden="true">t</kbd></dt><dd>Back to top</dd></div>
      <div><dt><kbd aria-hidden="true">?</kbd></dt><dd>Show this help</dd></div>
      <div><dt><kbd aria-hidden="true">Esc</kbd></dt><dd>Close overlay</dd></div>
    </dl>
  </div>
</div>

<style>
  .shortcuts-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--fg) 35%, transparent);
    backdrop-filter: blur(4px);
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .shortcuts-overlay.visible {
    display: flex;
    animation: fadeIn 0.15s ease-out;
  }
  .shortcuts-card {
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    max-width: 420px;
    width: 100%;
    /* color-mix shadow reads in both light and dark mode. */
    box-shadow: 0 20px 50px color-mix(in srgb, var(--fg) 20%, transparent);
  }
  .shortcuts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .shortcuts-header h2 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }
  .shortcuts-header button {
    background: transparent;
    border: none;
    color: var(--fg-faint);
    cursor: pointer;
    /* Touch target ≥44px (WCAG 2.5.5). */
    width: 44px;
    height: 44px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .shortcuts-header button:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  .shortcuts-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  .shortcuts-list > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
  }
  .shortcuts-list dt {
    display: flex;
    gap: 0.25rem;
    margin: 0;
  }
  .shortcuts-list dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--fg-soft);
  }
  kbd {
    /* Uses shared .kbd recipe for consistency with prose <kbd> and search hint */
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--fg) 8%, transparent);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.15em 0.5em;
    color: var(--fg);
    min-width: 1.75rem;
    text-align: center;
    display: inline-block;
    line-height: 1.4;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shortcuts-overlay.visible { animation: none; }
  }
</style>

<script>
  const overlay = document.getElementById('shortcuts-overlay');
  const closeBtn = overlay?.querySelector('[data-close-overlay]');
  let lastFocusedElement: HTMLElement | null = null;

  function getFocusableElements(): HTMLElement[] {
    if (!overlay) return [];
    return Array.from(overlay.querySelectorAll<HTMLElement>(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    )).filter(el => !el.hasAttribute('disabled'));
  }

  function showOverlay() {
    lastFocusedElement = document.activeElement as HTMLElement;
    overlay?.classList.add('visible');
    overlay?.setAttribute('aria-hidden', 'false');
    closeBtn?.focus();
  }
  function hideOverlay() {
    overlay?.classList.remove('visible');
    overlay?.setAttribute('aria-hidden', 'true');
    // Restore focus to the element that opened the overlay
    lastFocusedElement?.focus();
  }

  closeBtn?.addEventListener('click', hideOverlay);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) hideOverlay();
  });

  // Focus trap — Tab cycles within the overlay while it's open
  overlay?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !overlay.classList.contains('visible')) return;
    const focusable = getFocusableElements();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    } else {
      if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Single-key vs. two-key (g + x) sequence
  let prefix: 'g' | null = null;
  let prefixTimeout: number | undefined;

  function clearPrefix() {
    prefix = null;
    window.clearTimeout(prefixTimeout);
  }

  function isTyping(): boolean {
    const el = document.activeElement as HTMLElement | null;
    if (!el) return false;
    const tag = el.tagName.toLowerCase();
    return tag === 'input' || tag === 'textarea' || el.isContentEditable;
  }

  document.addEventListener('keydown', (e) => {
    // Esc always works (close overlay)
    if (e.key === 'Escape') {
      if (overlay?.classList.contains('visible')) {
        hideOverlay();
        e.preventDefault();
        return;
      }
      // Otherwise let the original handler (e.g. search ESC) run
    }

    // Don't intercept shortcuts when typing
    if (isTyping()) return;

    // Modifier-key combos are passed through (let user keep Cmd+K etc.)
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    // Two-key sequences: g then h/a/s/t
    if (prefix === 'g') {
      clearPrefix();
      switch (e.key) {
        case 'h': window.location.href = '/'; e.preventDefault(); return;
        case 'a': window.location.href = '/archive'; e.preventDefault(); return;
        case 's': window.location.href = '/search'; e.preventDefault(); return;
        case 't': {
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
          e.preventDefault();
          return;
        }
        default:
          // Unknown second key — ignore
          return;
      }
    }

    // Single-key shortcuts
    switch (e.key) {
      case '/':
        e.preventDefault();
        // If we're on the search page, just focus the input
        const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        } else {
          window.location.href = '/search';
        }
        return;
      case 't':
        e.preventDefault();
        document.getElementById('theme-toggle')?.click();
        return;
      case 'g':
        prefix = 'g';
        prefixTimeout = window.setTimeout(clearPrefix, 800);
        return;
      case '?':
        e.preventDefault();
        showOverlay();
        return;
    }
  });
</script>
