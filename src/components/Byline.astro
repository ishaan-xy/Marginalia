---
// Byline row — Medium/Substack pattern.
// Single row: avatar · author · date · read time.
// (Previously also had a Subscribe link — removed because the Header
// Subscribe pill is already visible above the byline on every post.
// Two subscribe entry points within ~100px of each other was overkill.)
import { SITE } from '@/lib/site';
import { formatDateLong, initials } from '@/lib/format';

interface Props {
  pubDate: Date;
  updatedDate?: Date | null;
  minutes: number;
  draft?: boolean;
}

const { pubDate, updatedDate, minutes, draft = false } = Astro.props;

const displayDate = updatedDate ?? pubDate;
const init = initials(SITE.author);
---

<div class="byline-row">
  <span class="avatar avatar-sm" aria-hidden="true">{init}</span>
  <div class="byline-meta">
    <span class="byline-author">{SITE.author}</span>
    <span class="byline-sep" aria-hidden="true">·</span>
    <time datetime={displayDate.toISOString()}>
      {updatedDate && 'Updated '}
      {formatDateLong(displayDate)}
    </time>
    <span class="byline-sep" aria-hidden="true">·</span>
    <span>{minutes} min read</span>
    {draft && (
      <>
        <span class="byline-sep" aria-hidden="true">·</span>
        <span class="text-[var(--accent)] font-medium">Draft</span>
      </>
    )}
  </div>
</div>

<style>
  /* Single-row byline — Medium pattern.
     Avatar + name + meta. Stacks gracefully on mobile. */
  .byline-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--fg-faint);
  }
  .byline-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex: 1;
    min-width: 0;
  }
  .byline-author {
    color: var(--fg);
    font-weight: 500;
  }
  .byline-sep {
    color: var(--fg-faint);
    opacity: 0.6;
    user-select: none;
  }
  /* Avatar — slightly smaller in byline context */
  .byline-row .avatar {
    width: 28px;
    height: 28px;
    font-size: 0.75rem;
  }
</style>
